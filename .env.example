# Copy to .env for local overrides. docker compose reads these.
# Host ports for Postgres and Redis (change them if you already run them locally)
DB_PORT=5432
REDIS_PORT=6379
POSTGRES_USER=moderation
POSTGRES_PASSWORD=moderation
POSTGRES_DB=moderation
DATABASE_URL=postgresql+asyncpg://moderation:moderation@db:5432/moderation
REDIS_URL=redis://redis:6379/0
PROVIDER_URL=http://provider:8001
# Where the provider sends async results for long videos
CALLBACK_URL=http://api:8000/provider/callback
# Shared HMAC-SHA256 secret for provider callbacks
PROVIDER_WEBHOOK_SECRET=change-me-in-real-life
# fixed = the safe pipeline, broken = the deliberately unsafe v0 that reproduces the incident
SCREENING_MODE=fixed
PROVIDER_TIMEOUT_SECONDS=2.0
HOLD_AFTER_SECONDS=20
LEASE_SECONDS=60
WORKSPACE_INFLIGHT_CAP=4
LOG_LEVEL=INFO

# Provider adapter for real file uploads (JPG, PNG, MP4, ...):
#   real = REAL_PROVIDER_URL, the bundled model (+ OpenAI below if a key is set)
#   mock = PROVIDER_URL, so a test mock on port 8001 scores real uploads too
# JSON test documents always go to PROVIDER_URL.
MODERATION_PROVIDER=real
# Optional second opinion from OpenAI moderation on real uploads (explicit, self-harm, violence).
OPENAI_API_KEY=
# Longer than the default because real videos are scored on CPU.
CALLBACK_TIMEOUT_SECONDS=300
